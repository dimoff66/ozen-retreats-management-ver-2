diff --git a/src/app/globals.css b/src/app/globals.css
index 38d492d..d29777c 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -2266,3 +2266,189 @@ input:focus-visible {
     padding: 10px;
   }
 }
+
+/* Retreat topbar and compact mobile admin navigation */
+.ozen-retreat-heading {
+  position: fixed;
+  top: 0;
+  left: calc(var(--sidebar-width) + 39px);
+  z-index: 42;
+  height: 67px;
+  max-width: calc(100vw - (var(--sidebar-width) * 2) - 410px);
+  display: flex;
+  align-items: center;
+  justify-content: flex-start;
+  gap: 8px;
+  margin: 0;
+}
+
+.ozen-retreat-heading-copy {
+  min-width: 0;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+.ozen-retreat-title-line {
+  min-width: 0;
+}
+
+.ozen-retreat-heading-copy h1 {
+  overflow: hidden;
+  font-size: 20px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.ozen-retreat-heading-copy > p:last-child {
+  margin: 0;
+  white-space: nowrap;
+}
+
+.ozen-retreat-more-button {
+  width: 34px;
+  height: 34px;
+  display: grid;
+  place-items: center;
+  flex: 0 0 auto;
+  padding: 0;
+  border: 1px solid #e4e9e5;
+  border-radius: 7px;
+  background: #fff;
+  color: #637168;
+  cursor: pointer;
+}
+
+.ozen-retreat-more-button:hover {
+  background: #f4f7f4;
+  color: #365c43;
+}
+
+@media (max-width: 1320px) {
+  .ozen-retreat-heading {
+    left: calc(var(--sidebar-width) + 26px);
+  }
+}
+
+@media (max-width: 820px) {
+  .ozen-app-shell {
+    display: grid;
+    grid-template-columns: 56px minmax(0, 1fr);
+  }
+
+  .ozen-side-slot-left {
+    display: block;
+    min-width: 0;
+  }
+
+  .ozen-side-slot-right {
+    display: none;
+  }
+
+  .ozen-sidebar {
+    width: 56px;
+    align-items: center;
+    padding: 12px 4px;
+  }
+
+  .ozen-sidebar .ozen-brand {
+    display: none;
+  }
+
+  .ozen-sidebar .ozen-side-nav {
+    width: 100%;
+    margin-top: 4px;
+  }
+
+  .ozen-sidebar .ozen-nav-item {
+    width: 44px;
+    height: 44px;
+  }
+
+  .ozen-topbar {
+    justify-content: flex-end;
+  }
+
+  .ozen-mobile-user-menu {
+    margin-right: 0;
+    margin-left: auto;
+    order: initial;
+  }
+
+  .ozen-retreat-heading {
+    left: 68px;
+    height: 60px;
+    max-width: calc(100vw - 68px - 72px);
+    gap: 5px;
+  }
+
+  .ozen-retreat-heading-copy {
+    display: block;
+  }
+
+  .ozen-retreat-heading-copy h1 {
+    font-size: 17px;
+  }
+
+  .ozen-retreat-heading-copy > p:last-child {
+    margin-top: 2px;
+    font-size: 10px;
+  }
+
+  .ozen-retreat-more-button {
+    width: 30px;
+    height: 30px;
+  }
+
+  .ozen-guests-list .ozen-table-panel {
+    overflow: visible;
+  }
+
+  .ozen-guests-list .ozen-data-table {
+    width: 100%;
+    min-width: 0;
+    table-layout: fixed;
+  }
+
+  .ozen-guests-list .ozen-data-table th,
+  .ozen-guests-list .ozen-data-table td {
+    padding-right: 4px;
+    padding-left: 4px;
+    overflow-wrap: anywhere;
+    font-size: 10px;
+  }
+
+  .ozen-guests-list .ozen-data-table th:nth-child(1) { width: 30%; }
+  .ozen-guests-list .ozen-data-table th:nth-child(2) { width: 18%; }
+  .ozen-guests-list .ozen-data-table th:nth-child(3) { width: 23%; }
+  .ozen-guests-list .ozen-data-table th:nth-child(4) { width: 20%; }
+  .ozen-guests-list .ozen-data-table th:nth-child(5) { width: 9%; }
+
+  .ozen-guests-list .ozen-table-status {
+    max-width: 100%;
+    padding: 3px 4px;
+    white-space: normal;
+    line-height: 1.15;
+  }
+
+  .ozen-guests-list .ozen-row-more {
+    width: 24px;
+    height: 28px;
+  }
+
+  .ozen-guests-list .ozen-room-link {
+    white-space: normal;
+    overflow-wrap: anywhere;
+  }
+}
+
+@media (max-width: 600px) {
+  .ozen-page-content {
+    padding-right: 8px;
+    padding-left: 8px;
+  }
+
+  .ozen-retreat-heading-copy h1 {
+    font-size: 15px;
+  }
+}
