+
+/* Retreat room configuration */
+.ozen-room-settings-screen {
+  min-width: 0;
+}
+
+.ozen-room-settings-header {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 18px;
+  margin-bottom: 16px;
+}
+
+.ozen-room-settings-header h2 {
+  margin: 0;
+  color: #37463b;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 20px;
+  line-height: 1.25;
+  font-weight: 500;
+}
+
+.ozen-room-settings-header p {
+  margin: 6px 0 0;
+  color: #8b9690;
+  font-size: 13px;
+}
+
+.ozen-room-settings-message {
+  padding: 14px 16px;
+  border: 1px solid #e9ede9;
+  border-radius: 8px;
+  background: #fff;
+  color: #7f8b83;
+}
+
+.ozen-room-settings-error {
+  margin-bottom: 14px;
+  border-color: #f0ded9;
+  background: #fff9f7;
+  color: #a25f55;
+}
+
+.ozen-room-house-list {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+}
+
+.ozen-room-house {
+  overflow: hidden;
+  border: 1px solid #e9ede9;
+  border-radius: 9px;
+  background: #fff;
+}
+
+.ozen-room-house-header {
+  min-height: 62px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 14px;
+  padding: 12px 14px 12px 16px;
+  border-bottom: 1px solid #edf0ed;
+  background: #fafbfa;
+}
+
+.ozen-room-house-header h3 {
+  margin: 0;
+  color: #3d4d42;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 17px;
+  font-weight: 500;
+}
+
+.ozen-room-house-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 7px;
+}
+
+.ozen-room-small-button {
+  min-height: 32px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 0 10px;
+  border: 1px solid #e2e8e3;
+  border-radius: 6px;
+  background: #fff;
+  color: #5f6d63;
+  font-size: 12px;
+  font-weight: 600;
+  cursor: pointer;
+  transition: background .15s, border-color .15s, color .15s;
+}
+
+.ozen-room-small-button:hover {
+  border-color: #bdcbbf;
+  background: #f8faf8;
+}
+
+.ozen-room-small-button-positive {
+  border-color: #d8e6da;
+  background: #f2f7f3;
+  color: #477054;
+}
+
+.ozen-room-small-button-positive:hover {
+  border-color: #bdd2c0;
+  background: #eaf3ec;
+}
+
+.ozen-room-max-control {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  margin-left: 3px;
+  padding-left: 10px;
+  border-left: 1px solid #e6ebe7;
+  color: #7d8981;
+  font-size: 12px;
+  font-weight: 600;
+  white-space: nowrap;
+}
+
+.ozen-room-number-input {
+  width: 62px;
+  height: 32px;
+  padding: 0 8px;
+  border: 1px solid #dde4de;
+  border-radius: 6px;
+  background: #fff;
+  color: #4f5f55;
+  text-align: center;
+}
+
+.ozen-room-number-input:disabled {
+  background: #f4f6f4;
+  color: #a2aaa5;
+}
+
+.ozen-room-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 9px;
+  padding: 12px;
+}
+
+.ozen-room-setting-row {
+  min-width: 0;
+  min-height: 54px;
+  display: grid;
+  grid-template-columns: auto minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 11px;
+  padding: 10px 11px;
+  border: 1px solid #edf0ed;
+  border-radius: 7px;
+  background: #fff;
+  transition: border-color .15s, background .15s;
+}
+
+.ozen-room-setting-row:hover {
+  border-color: #d6e0d8;
+  background: #fbfcfb;
+}
+
+.ozen-room-setting-row:has(input[type="checkbox"]:disabled) {
+  background: #f7f8f7;
+}
+
+.ozen-room-checkbox {
+  width: 18px;
+  height: 18px;
+  accent-color: #4b7358;
+}
+
+.ozen-room-setting-copy {
+  min-width: 0;
+}
+
+.ozen-room-setting-name {
+  display: block;
+  overflow: hidden;
+  color: #435149;
+  font-size: 13px;
+  font-weight: 650;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.ozen-room-unavailable-note {
+  display: block;
+  margin-top: 3px;
+  color: #9aa39d;
+  font-size: 11px;
+}
+
+.ozen-room-capacity {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  color: #7c8880;
+  font-size: 12px;
+  white-space: nowrap;
+}
+
+.ozen-room-settings-footer {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+  margin-top: 16px;
+  padding-top: 14px;
+  border-top: 1px solid #e9ede9;
+}
+
+@media (max-width: 900px) {
+  .ozen-room-house-header {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .ozen-room-house-actions {
+    width: 100%;
+    justify-content: flex-start;
+  }
+
+  .ozen-room-grid {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+@media (max-width: 600px) {
+  .ozen-room-settings-header {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+
+  .ozen-room-house-actions {
+    align-items: stretch;
+  }
+
+  .ozen-room-small-button {
+    flex: 1 1 calc(50% - 4px);
+  }
+
+  .ozen-room-max-control {
+    width: 100%;
+    margin-left: 0;
+    padding: 8px 0 0;
+    border-top: 1px solid #e6ebe7;
+    border-left: 0;
+  }
+
+  .ozen-room-setting-row {
+    grid-template-columns: auto minmax(0, 1fr);
+  }
+
+  .ozen-room-capacity {
+    grid-column: 2;
+  }
+}
+
 .sr-only {
   position: absolute;
   width: 1px;
